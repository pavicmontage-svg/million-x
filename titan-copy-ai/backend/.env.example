# ---- TITAN backend configuration (copy to .env, never commit .env) ----
TITAN_ENV=production
TITAN_DOMAIN=titan.example.com
POSTGRES_PASSWORD=change-me-long-random
# TITAN_DATABASE_URL / TITAN_REDIS_URL are set by docker-compose.yml from POSTGRES_PASSWORD.
TITAN_BACKUP_DIR=/backups
# 32-byte key for AES-256-GCM credential encryption. Generate: docker compose run --rm api python -m titan.cli genkey
# Stored as the Docker secret file ./secrets/titan_master_key (mounted at /run/secrets/titan_master_key).
# One-time bootstrap pairing code (only valid while no device is paired). Optional; `titan.cli pair` is preferred.
TITAN_BOOTSTRAP_CODE=
# Live trading stays OFF until you have >= 30 days of paper evidence and deliberately enable it.
TITAN_LIVE_TRADING_ENABLED=false
TITAN_FOREX_INITIAL_CAPITAL_EUR=500
TITAN_CRYPTO_INITIAL_CAPITAL_USDT=500
# Optional: Claude review for the six agents (deterministic analysis runs without it).
ANTHROPIC_API_KEY=
TITAN_LLM_MODEL=claude-opus-5-5
# Optional: Firebase Cloud Messaging (HTTP v1) push.
TITAN_FCM_PROJECT_ID=
TITAN_FCM_SERVICE_ACCOUNT_FILE=
# Optional: economic calendar JSON feed of your choice (list of {date,country,impact,title}).
TITAN_CALENDAR_URL=
