# Generate with: docker compose run --rm backend python -m millionx.cli genkey
MX_MASTER_KEY=
# paper | demo | live   (live is refused until preflight passes and the owner unlocks it)
MX_MODE=paper
MX_EXECUTION=manual
MX_CAPITAL_MODE=multi
MX_DB_PATH=/app/data/millionx.db
MX_DATA_DIR=/app/data/klines
# Public domain pointing at the server (Caddy obtains the HTTPS certificate)
MX_DOMAIN=mx.example.com
# Optional: AI brains (Claude API). Without it the brains run deterministic rules only.
ANTHROPIC_API_KEY=
MX_LLM_MODEL=claude-haiku-5-5
# Optional: {"claude-haiku-5-5": [input_usd_per_Mtok, output_usd_per_Mtok]} from the current price list
MX_LLM_PRICES={}
# Optional: Firebase service account for push notifications
MX_FCM_SERVICE_ACCOUNT=/app/secrets/firebase-service-account.json
